{
  "name": "@voirdev/cloak-client",
  "version": "0.0.0",
  "description": "Cloak client for TypeScript: unlock, read, write, share and rotate end-to-end encrypted nodes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoirDev/cloak.git",
    "directory": "cloak-ts/packages/client"
  },
  "type": "module",
  "sideEffects": [
    "./src/kdf/kdfWorker.ts",
    "./dist/kdf/kdfWorker.js"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kdf-worker": {
      "source": "./src/kdf/kdfWorker.ts",
      "types": "./dist/kdf/kdfWorker.d.ts",
      "import": "./dist/kdf/kdfWorker.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../cloak-protocol/openapi/cloak-api.v1.yaml -o src/generated/cloakApi.ts",
    "generate:check": "node scripts/checkGenerated.ts",
    "typecheck": "pnpm generate:check && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@voirdev/cloak-crypto": "workspace:*",
    "openapi-fetch": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fake-indexeddb": "catalog:",
    "openapi-typescript": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
